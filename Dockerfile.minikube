# MATRIX Core — Minikube/Development build (JVM, Quarkus fast-jar)
#
# Pre-build (outside the image):
#   ./gradlew :matrix-core:quarkusBuild --no-daemon
# Then:
#   docker build -f Dockerfile.minikube -t matrix-core:minikube .
#
# Same packaging as ./Dockerfile (Quarkus fast-jar): the runnable artifact is
# the whole quarkus-app/ directory, not a single jar.
#
# Models are mounted from the host via a hostPath volume (see
# infra/k8s/minikube/); they are not copied into the image, because /models
# is git-ignored and the checkpoints are large.

FROM eclipse-temurin:25-jre AS runtime
WORKDIR /app

COPY matrix-core/build/quarkus-app/ /app/quarkus-app/

EXPOSE 9091

# No curl/wget in this base image: use bash's /dev/tcp against the real
# readiness endpoint.
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/9091 && printf "GET /q/health/ready HTTP/1.0\r\nHost: localhost\r\n\r\n" >&3 && grep -q "200 OK" <&3' || exit 1

ENTRYPOINT ["java","-Xms256m","-Xmx1024m","-XX:+UseZGC","-XX:MaxRAMPercentage=75.0","-jar","/app/quarkus-app/quarkus-run.jar"]
